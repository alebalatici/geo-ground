# Docker / PostgreSQL + PostGIS
POSTGRES_USER=geoground
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=geoground

# Backend FastAPI & Database
DATABASE_URL=postgresql+psycopg2://geoground:your_secure_password_here@127.0.0.1:5433/geoground
DB_ECHO=False

# Google Earth Engine
GEE_PROJECT_ID=your-gee-project-id

# Gemini LLM Executive Layer
GEMINI_API_KEY
LLM_MODEL_GEMINI=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15.0